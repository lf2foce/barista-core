# Địa chỉ core (mặc định http://127.0.0.1:8300)
BARISTA_CORE_URL=http://127.0.0.1:8300
# BẮT BUỘC khi chạy production (≥ 16 ký tự ngẫu nhiên): khoá mã hoá cookie phiên
BARISTA_SESSION_SECRET=
# 1 = cho phép đăng nhập chọn vai dev khi NODE_ENV=production (core cũng phải bật BARISTA_DEV_AUTH=1)
BARISTA_WEB_DEV_LOGIN=
# Client ID loại "Web" cho nút Google (mặc định dùng client_id core công bố)
BARISTA_GOOGLE_WEB_CLIENT_ID=
# Bản demo trên VPS: khoá gửi kèm mọi lệnh gọi core kiểu dev (core đặt cùng giá trị ở BARISTA_DEMO_KEY). Chỉ phía server.
BARISTA_DEMO_KEY=
